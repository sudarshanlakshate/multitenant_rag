# Copy this file to .env and fill in your real values.
# NEVER commit .env with live secrets.

# OpenAI API key (embeddings + LLM)
OPENAI_API_KEY=sk-proj-YOUR-KEY-HERE

# PostgreSQL connection URL
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/ragdb

# ChromaDB persistence directory (default: ./chroma_db)
# CHROMA_PATH=./chroma_db

# LangSmith tracing (optional)
# LANGCHAIN_API_KEY=lsv2_pt_...
# LANGCHAIN_PROJECT=langchain

# vLLM inference (optional)
# VLLM_ENABLED=true
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# VLLM_API_KEY=EMPTY

# Query translation via Ollama (optional)
# OLLAMA_TRANSLATION_MODEL=qwen2.5:7b-instruct
# OLLAMA_TRANSLATION_BASE_URL=http://localhost:11434