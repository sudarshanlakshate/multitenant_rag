# Copy this file to .env and fill in your real values.
# NEVER commit .env with live secrets.

# OpenAI API key (embeddings + LLM)
OPENAI_API_KEY=sk-proj-YOUR-KEY-HERE

# PostgreSQL connection URL
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/ragdb

# ChromaDB persistence directory (default: ./chroma_db)
# CHROMA_PATH=./chroma_db

# LangSmith tracing (optional)
# LANGCHAIN_API_KEY=lsv2_pt_...
# LANGCHAIN_PROJECT=langchain